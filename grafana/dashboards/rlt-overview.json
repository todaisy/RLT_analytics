      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reaction) (alpharag_bot_reactions{job=\"alpharag\",reaction=~\"like|dislike\"})",
          "legendFormat": "{{reaction}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "Текущие реакции на сохранённые ответы бота за всё время. Смена и снятие реакции меняют значение; rate/increase неприменимы.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
