{
  "uid": "rlt-overview",
  "title": "RLT Analytics",
  "tags": [
    "rlt"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Доступность источников",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"support_service|alpharag\"}",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "1 — scrape успешен, 0 — источник недоступен."
    },
    {
      "id": 2,
      "title": "Закрытые диалоги за выбранный период",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(support_chat_lifetime_seconds_count{job=\"support_service\",line=~\"$line\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Оценка прироста счётчика Prometheus, может быть дробной."
    },
    {
      "id": 3,
      "title": "Средняя длительность закрытого диалога",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (line) (rate(support_chat_lifetime_seconds_sum{job=\"support_service\",line=~\"$line\"}[$__rate_interval])) / sum by (line) (rate(support_chat_lifetime_seconds_count{job=\"support_service\",line=~\"$line\"}[$__rate_interval]))",
          "legendFormat": "Линия {{line}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
      "id": 4,
      "title": "P95 длительности закрытого диалога",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, line) (rate(support_chat_lifetime_seconds_bucket{job=\"support_service\",line=~\"$line\"}[$__rate_interval])))",
          "legendFormat": "Линия {{line}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
      "id": 5,
      "title": "Среднее время первого ответа по текущей оценке",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (line, rating) (support_first_response_seconds_sum{job=\"support_service\",line=~\"$line\"}) / sum by (line, rating) (support_first_response_seconds_count{job=\"support_service\",line=~\"$line\"})",
          "legendFormat": "Линия {{line}}, оценка {{rating}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Снимок за всё время, а не прирост за выбранный период. none — без оценки. При изменении оценки диалог переходит в другую группу; rate() неприменим."
    },
    {
      "id": 6,
      "title": "Средняя оценка за выбранный период",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (line) (increase(support_feedback_score_total{job=\"support_service\",line=~\"$line\"}[$__range])) / sum by (line) (increase(support_feedback_total{job=\"support_service\",line=~\"$line\"}[$__range]))",
          "legendFormat": "Линия {{line}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Изменённая оценка считается новым наблюдением. Без новых оценок — No data."
    },
    {
      "id": 7,
      "title": "Оценки за выбранный период",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (line, rating) (increase(support_feedback_total{job=\"support_service\",line=~\"$line\"}[$__range]))",
          "legendFormat": "Линия {{line}}, оценка {{rating}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": ""
    },
    {
      "id": 8,
      "title": "AlphaRAG: HTTP запросов/с",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (rate(alpharag_http_requests_total{job=\"alpharag\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
      "id": 9,
      "title": "AlphaRAG: HTTP по статусам",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(alpharag_http_requests_total{job=\"alpharag\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
      "id": 10,
      "title": "AlphaRAG: доля HTTP 5xx",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(alpharag_http_requests_total{job=\"alpharag\",status=~\"5..\"}[$__rate_interval]) or (0 * rate(alpharag_http_requests_total{job=\"alpharag\"}[$__rate_interval]))) / sum(rate(alpharag_http_requests_total{job=\"alpharag\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
